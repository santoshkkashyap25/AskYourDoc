# Application Settings
APP_NAME=AskYourDoc
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage & Logging Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma_db
CACHE_DB_PATH=data/cache.db
LOG_DIR=logs
LOG_LEVEL=INFO

# Storage Limits
MAX_DOCUMENTS=10
MAX_TOTAL_STORAGE_MB=25

# Document Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# RAG & Embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
RETRIEVER_TOP_K=4
SIMILARITY_THRESHOLD=0.35

# LLM Provider: mock | groq | grok | local | openai | gemini | ollama
LLM_PROVIDER=groq
LOCAL_HF_MODEL_NAME=google/flan-t5-base

# Groq (Free Tier: Fast LPU inference with Llama 3.3 70B / Llama 3.1 8B)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# xAI Grok (grok-beta / grok-2)
# Get a key at: https://console.x.ai/
GROK_API_KEY=
GROK_MODEL_NAME=grok-beta

# API Keys (Optional - only needed if LLM_PROVIDER is set accordingly)
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# Cache TTL in seconds (e.g. 86400 = 24 hours, None = forever)
CACHE_TTL_SECONDS=86400
